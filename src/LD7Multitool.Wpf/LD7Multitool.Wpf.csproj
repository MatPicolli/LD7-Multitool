<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LD7Multitool.Wpf</RootNamespace>
    <AssemblyName>LD7Multitool.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Mesma versão fixada do WinForms (corrige NU1903 / GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
  </ItemGroup>

  <!--
    O projeto WPF não traz System.IO nos implicit usings (o WinForms traz), e o
    Database.cs compartilhado usa Path/File. Adiciona o using só aqui, sem
    alterar o arquivo original.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    Reaproveita a camada de dados do projeto WinForms SEM duplicar código nem
    tocar nele: os arquivos são apenas "linkados" (compilados também aqui).
    Todos são independentes de UI (só SQLite/System), então servem aos dois.
  -->
  <ItemGroup>
    <Compile Include="..\LD7Multitool\Core\Database.cs" Link="Compartilhado\Database.cs" />
    <Compile Include="..\LD7Multitool\Modulos\Clientes\Cliente.cs" Link="Compartilhado\Cliente.cs" />
    <Compile Include="..\LD7Multitool\Modulos\Clientes\ClienteRepository.cs" Link="Compartilhado\ClienteRepository.cs" />
    <Compile Include="..\LD7Multitool\Modulos\Clientes\Mascaras.cs" Link="Compartilhado\Mascaras.cs" />
  </ItemGroup>

</Project>
