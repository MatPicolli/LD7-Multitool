<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta (mesma do Estilo.cs do WinForms) -->
    <SolidColorBrush x:Key="Fundo" Color="#F5F6FA" />
    <SolidColorBrush x:Key="Superficie" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Primaria" Color="#3B5BDB" />
    <SolidColorBrush x:Key="PrimariaHover" Color="#2F4AB7" />
    <SolidColorBrush x:Key="Texto" Color="#23262E" />
    <SolidColorBrush x:Key="TextoSuave" Color="#6E7382" />
    <SolidColorBrush x:Key="Borda" Color="#D7DAE4" />
    <SolidColorBrush x:Key="Menu" Color="#1E202C" />
    <SolidColorBrush x:Key="MenuHover" Color="#303346" />
    <SolidColorBrush x:Key="MenuTexto" Color="#C7CAD4" />
    <SolidColorBrush x:Key="Selecao" Color="#E2E9FF" />
    <SolidColorBrush x:Key="LinhaAlternada" Color="#FAFAFD" />
    <SolidColorBrush x:Key="LinhaGrade" Color="#E8EAF0" />

    <!-- Item do menu lateral (RadioButton com destaque de ativo) -->
    <Style x:Key="ItemMenu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MenuTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="fundo" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource MenuHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource Primaria}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão primário -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primaria}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource PrimariaHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de texto -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Grade -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{StaticResource Superficie}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource LinhaAlternada}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LinhaGrade}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        <!-- Borda à direita = divisor entre cabeçalhos; embaixo = linha do topo -->
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Height" Value="34" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{StaticResource Primaria}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
